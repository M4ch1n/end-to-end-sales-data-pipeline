    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var final_amount = quantity * base_price * (1 - discount_applied);</jsScript_script>
